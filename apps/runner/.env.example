# apps/runner — env

# Outbound WS to ECS server
SERVER_URL=ws://127.0.0.1:3000/ws/runner

# Must match the server's RUNNER_PAIRING_TOKEN
RUNNER_PAIRING_TOKEN=

# Adapter choice: sdk | cli | fake | (auto: sdk if ANTHROPIC_API_KEY present, else fake)
RUNNER_ADAPTER=

# --- Claude Agent SDK (only used when RUNNER_ADAPTER=sdk or auto-with-key) ---
# Get one at https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_EFFORT=
RUNNER_DEFAULT_CWD=~

# Skills directory (where <skill-name>/SKILL.md files live).
# Default: $cwd/skills or $cwd/.claude/skills or <repo>/skills
RUNNER_SKILLS_DIR=

# Optional device name override
RUNNER_NAME=

LOG_LEVEL=info
