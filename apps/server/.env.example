# apps/server — env

# Bind
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Tokens (must be set in production; ephemeral dev tokens generated if blank)
# Generate: openssl rand -base64 32
ADMIN_TOKEN=
RUNNER_PAIRING_TOKEN=

# Uploads
UPLOAD_DIR=/tmp/e2e-bridge-uploads

# Comma-separated list of repo path prefixes runners will accept (M2: ignored, M3+ enforced)
RUNNER_REPO_ALLOWLIST=~

# Set to 'production' to disable dev-only routes (e.g. test-hitl)
NODE_ENV=development
