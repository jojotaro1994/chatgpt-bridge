{
  "name": "prj-bridge-phone",
  "version": "0.0.1",
  "private": true,
  "description": "e2e-bridge: self-hosted mobile/web ↔ ECS server ↔ local runner bridge",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/server' build",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/server' typecheck",
    "test": "pnpm -r --filter './packages/*' --filter './apps/server' test",
    "clean": "pnpm -r exec rm -rf dist .turbo"
  }
}
